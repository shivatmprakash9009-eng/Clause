# Canonical origin used for sitemap, Open Graph and canonical URLs (required for production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Cloudflare Turnstile bot protection on forms
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Optional: where valid leads are forwarded (CRM / automation webhook). Unset = logged server-side only.
LEAD_WEBHOOK_URL=
