  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": "0 1px 0 oklch(1 0 0 / .8) inset, 0 1px 2px oklch(0.26 0.04 173 / .06)"
    },
    "pop": {
      "$value": "0 1px 2px oklch(0.26 0.04 173 / .08), 0 6px 16px -6px oklch(0.26 0.04 173 / .14)"
    },
    "brand": {
      "$value": "0 1px 0 oklch(1 0 0 / .18) inset, 0 4px 12px -4px oklch(0.358 0.07 172 / .5)"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": "var(--font-aspekta), 'Geist', ui-sans-serif, sans-serif"
      }
    },
    "size": {
      "$type": "dimension",
      "display": {
        "$value": "clamp(2.5rem, 1.2rem + 5.2vw, 4.75rem)"
      },
      "h2": {
        "$value": "clamp(1.875rem, 1.2rem + 2.6vw, 2.75rem)"
      },
      "h3": {
        "$value": "2.25rem"
      },
      "quote": {
        "$value": "clamp(1.5rem, 1rem + 2vw, 2.5rem)"
      },
      "stat": {
        "$value": "clamp(2.5rem, 1.6rem + 3.4vw, 4rem)"
      },
      "body-lg": {
        "$value": "1.125rem"
      },
      "body": {
        "$value": "1rem"
      },
      "small": {
        "$value": "1rem"
      },
      "eyebrow": {
        "$value": "0.6875rem"
      },
      "cta": {
        "$value": "clamp(1.75rem, 1.2rem + 2.4vw, 2.75rem)"
      },
      "mark": {
        "$value": "1.375rem"
      }
    }
  },
  "ease": {
    "$type": "cubicBezier",
    "out-expo": {
      "$value": "cubic-bezier(0.16, 1, 0.3, 1)"
    },
    "in-out": {
      "$value": "cubic-bezier(0.65, 0, 0.35, 1)"
    }
  },
  "dur": {
    "$type": "duration",
    "feedback": {
      "$value": "140ms"
    },
    "state": {
      "$value": "260ms"
